{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shmotix",
  "version": "0.1.0",
  "identifier": "dev.shmotix.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "lens",
        "title": "Shmotix",
        "width": 700, "height": 180, "x": 200, "y": 600,
        "decorations": false, "transparent": true, "alwaysOnTop": true,
        "shadow": false, "resizable": true
      }
    ]
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png","icons/128x128.png","icons/icon.icns","icons/icon.ico"] }
}
